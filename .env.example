# ============================================
# NFT Public Mint — Vue 3 web configuration
# ============================================
# Copy to .env:   cp .env.example .env

# Required. The web app mints with this single wallet only.
# Use a dedicated hot wallet funded only with what you intend to spend.
PRIVATE_KEY=

# Server port for the Express API + production Vue build.
PORT=3003

# --- Gas defaults (gwei) ---
# Used as UI defaults/documentation; the web form can override these per run.
# The max fee is a CEILING, not what you pay. But note
# a node reserves gasLimit × maxFee upfront, so the wallet must hold that much.
MAX_FEE_PER_GAS=2
MAX_PRIORITY_FEE=0.05

# Gas limit per mint tx. A SeaDrop mint uses roughly 135k for quantity 1.
GAS_LIMIT=250000
